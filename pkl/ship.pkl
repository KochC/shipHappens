/// Ship Happens — pipeline schema for Pkl.
///
/// Import this module to author a pipeline in Pkl (a typed, sandboxed config
/// language). Evaluating a pipeline to JSON (`pkl eval -f json`) produces the
/// exact RunPlan shape Ship Happens consumes:
///
///     amends "ship.pkl"
///     name = "CI"
///     jobs { … }
///
/// Then run it with:  ship run pipeline.pkl   (or: go run ./cmd/ship run …)
@ModuleInfo { minPklVersion = "0.25.0" }
module ship

/// Workflow name.
name: String

/// Workflow-level variables, merged into every job's environment
/// (job `env` overrides on key collision).
vars: Mapping<String, String>?

/// Pinned tool versions for NATIVE jobs (e.g. { ["go"] = "1.22.5" }). Ship
/// Happens resolves these (via mise) into a per-run PATH so native steps get
/// reproducible versions without containers. Job `toolchain` overrides per key.
toolchain: Mapping<String, String>?

/// Warm-up work run concurrently before the DAG (image pulls + optional
/// cache-priming commands). Advisory — failures never fail the build.
preheat: Listing<Preheat>?

/// Supply-chain / network security policy for the whole workflow.
security: Security?

/// Live run notifications (desktop / webhook / exec). Best-effort delivery.
notify: Notify?

/// The jobs in the pipeline. Keys are job ids; the id is injected automatically.
jobs: Mapping<String, Job>

/// Workflow-wide supply-chain defaults.
class Security {
  /// Container jobs run with no network unless they opt in (job `network = true`
  /// or a non-empty `allow` list). Recommended: most build/test steps need none.
  offlineByDefault: Boolean = false
  /// Egress allow-list applied to jobs that opt into network without their own.
  defaultAllow: Listing<String>?
}

/// Live run notifications for the whole workflow. All delivery is best-effort:
/// a failed notification never affects the build.
class Notify {
  /// Post native desktop notifications (macOS `osascript` / Linux `notify-send`).
  desktop: Boolean = false
  /// POST a JSON event to this URL on notify.
  webhook: String?
  /// Run this shell command on notify; the event is passed via `SHIP_NOTIFY_*` env.
  exec: String?
  /// Also notify when the run starts (not just on completion).
  onStart: Boolean = false
  /// Also notify on each job failure (not just the final result).
  onJob: Boolean = false
}

/// A sidecar service container for a job (e.g. a database).
class Service {
  /// Hostname the job's container steps use to reach the service.
  name: String
  /// Service image.
  image: String
  /// Service container environment.
  env: Mapping<String, String>?
  /// host:container port publishes.
  ports: Listing<String>?
  /// Shell command run inside the service to test readiness.
  health: String?
  /// Readiness timeout in seconds (default 30).
  timeout: Int = 0
}


/// A preheat entry: pull an image and optionally run a warm command in it.
class Preheat {
  /// Image to pull.
  image: String
  /// Optional shell command to run in the image (e.g. prime a toolchain cache).
  warm: String?
  /// Volume mounts for the warm command.
  mounts: Listing<String>?
}

/// A secret required by a job. Resolved at run time from the host environment
/// (`fromEnv`, defaulting to `name`) — the value is never stored in the plan.
class Secret {
  /// Env var name exposed to the job's steps.
  name: String
  /// Host env var to read from; defaults to `name`.
  fromEnv: String?
}

/// Cache hints for a step's result (content-addressed step cache).
class Cache {
  /// File globs whose content contributes to the cache key.
  inputs: Listing<String>?
  /// File globs stored on miss and restored on hit.
  outputs: Listing<String>?
}

/// One executable step within a job.
class Step {
  /// Step name/id.
  id: String
  /// Shell command.
  run: String
  /// Optional cache hint.
  cache: Cache?
  /// Step-level environment variables (override job env).
  env: Mapping<String, String>?
  /// Working directory (relative to the workdir) to run the step in.
  workingDir: String?
  /// Shell/interpreter to use (default "sh"); e.g. "bash", "python", "node".
  shell: String?
  /// Per-step timeout in seconds (0 = none).
  timeoutSec: Int = 0
  /// Number of additional attempts if the step fails (total = retries + 1).
  retries: Int = 0
  /// Delay between retry attempts, in seconds.
  retryBackoffSec: Int = 0
  /// If true, a failing step does not fail the job; execution proceeds.
  continueOnError: Boolean = false
  /// Conditional expression; the step is skipped when it evaluates false.
  /// May reference outputs.self.<key> for this job's captured outputs.
  `if`: String?
  /// Step-level dependencies (other step ids in this job). When any step has
  /// needs, the job's steps run as a DAG (parallel where possible).
  needs: Listing<String>?
  /// Handler steps run only if this step fails (e.g. collect logs / report).
  onFailure: Listing<Step>?
}

/// A DAG node. Runs its steps sequentially on one runner.
class Job {
  /// Execution label; informational. The runner is selected by `image`.
  runsOn: String = "native"
  /// Container image; when set, the job runs in a container.
  image: String?
  /// Ids of jobs this one depends on.
  needs: Listing<String>?
  /// Job-scoped environment variables.
  env: Mapping<String, String>?
  /// Pinned native tool versions for this job (overrides workflow toolchain).
  toolchain: Mapping<String, String>?
  /// Secrets exposed to this job's steps.
  secrets: Listing<Secret>?
  /// The steps to run.
  steps: Listing<Step>
  /// Path globs deleted after the job succeeds (prune build intermediates).
  cleanAfter: Listing<String>?
  /// Container networking: null = engine default, true = on, false = isolated.
  network: Boolean?
  /// File globs persisted as the job's result for `--resume`.
  outputs: Listing<String>?
  /// Run a container job in an overlayfs upper layer (Linux; graceful fallback).
  overlay: Boolean = false
  /// Whole-job timeout in seconds (0 = none).
  timeoutSec: Int = 0
  /// If true, a failing job does not fail the run or cancel siblings.
  continueOnError: Boolean = false
  /// Conditional expression; the job is skipped when it evaluates false.
  /// May reference env.X, vars.X, needs.<job>.result, outputs.<job>.<key>,
  /// and success()/failure()/always().
  `if`: String?
  /// Egress host allow-list. A non-empty list opts the job into network (even
  /// under offlineByDefault) but scopes egress to these hosts.
  allow: Listing<String>?
  /// Sidecar services started before the job's steps and torn down after.
  services: Listing<Service>?
  /// Fan this job out over the cartesian product of the named dimensions. Each
  /// combination becomes a job "<id>/<v1>-<v2>-…" (dimension keys sorted) with
  /// the values injected as UPPERCASED env vars (os=linux → $OS). Dependents on
  /// a matrix job depend on all of its expansions. Expanded at load time.
  matrix: Mapping<String, Listing<String>>?
}


/// Render to the RunPlan JSON shape Ship Happens consumes. `pkl eval -f json`
/// on a module that amends `ship.pkl` yields exactly this object.
output {
  renderer = new JsonRenderer {}
  value = new Dynamic {
    name = module.name
    when (module.vars != null) { vars = module.vars }
    when (module.toolchain != null) { toolchain = module.toolchain }
    when (module.security != null) {
      security = new Dynamic {
        when (module.security.offlineByDefault) { ["offlineByDefault"] = true }
        when (module.security.defaultAllow != null) { ["defaultAllow"] = module.security.defaultAllow }
      }
    }
    when (module.notify != null) {
      notify = new Dynamic {
        when (module.notify.desktop) { ["desktop"] = true }
        when (module.notify.webhook != null) { ["webhook"] = module.notify.webhook }
        when (module.notify.exec != null) { ["exec"] = module.notify.exec }
        when (module.notify.onStart) { ["onStart"] = true }
        when (module.notify.onJob) { ["onJob"] = true }
      }
    }
    when (module.preheat != null) {
      preheat = new Listing {
        for (ph in module.preheat!!) {
          new Dynamic {
            ["image"] = ph.image
            when (ph.warm != null) { ["warm"] = ph.warm }
            when (ph.mounts != null) { ["mounts"] = ph.mounts }
          }
        }
      }
    }
    jobs = new Listing {
      for (id, j in module.jobs) {
        new Dynamic {
          ["id"] = id
          ["runsOn"] = j.runsOn
          when (j.image != null) { ["image"] = j.image }
          when (j.needs != null) { ["needs"] = j.needs }
          when (j.env != null) { ["env"] = j.env }
          when (j.toolchain != null) { ["toolchain"] = j.toolchain }
          when (j.secrets != null) {
            ["secrets"] = new Listing {
              for (s in j.secrets!!) {
                new Dynamic {
                  ["name"] = s.name
                  when (s.fromEnv != null) { ["fromEnv"] = s.fromEnv }
                }
              }
            }
          }
          ["steps"] = new Listing {
            for (st in j.steps) {
              new Dynamic {
                ["id"] = st.id
                ["run"] = st.run
                when (st.cache != null) {
                  ["cache"] = new Dynamic {
                    when (st.cache.inputs != null) { ["inputs"] = st.cache.inputs }
                    when (st.cache.outputs != null) { ["outputs"] = st.cache.outputs }
                  }
                }
                when (st.env != null) { ["env"] = st.env }
                when (st.workingDir != null) { ["workingDir"] = st.workingDir }
                when (st.shell != null) { ["shell"] = st.shell }
                when (st.timeoutSec > 0) { ["timeoutSec"] = st.timeoutSec }
                when (st.retries > 0) { ["retries"] = st.retries }
                when (st.retryBackoffSec > 0) { ["retryBackoffSec"] = st.retryBackoffSec }
                when (st.continueOnError) { ["continueOnError"] = true }
                when (st.`if` != null) { ["if"] = st.`if` }
                when (st.needs != null) { ["needs"] = st.needs }
                when (st.onFailure != null) {
                  ["onFailure"] = new Listing {
                    for (h in st.onFailure!!) {
                      new Dynamic {
                        ["id"] = h.id
                        ["run"] = h.run
                        when (h.env != null) { ["env"] = h.env }
                        when (h.workingDir != null) { ["workingDir"] = h.workingDir }
                        when (h.shell != null) { ["shell"] = h.shell }
                        when (h.`if` != null) { ["if"] = h.`if` }
                        when (h.continueOnError) { ["continueOnError"] = true }
                      }
                    }
                  }
                }
              }
            }
          }
          when (j.cleanAfter != null) { ["cleanAfter"] = j.cleanAfter }
          when (j.network != null) { ["network"] = j.network }
          when (j.outputs != null) { ["outputs"] = j.outputs }
          when (j.overlay) { ["overlay"] = true }
          when (j.timeoutSec > 0) { ["timeoutSec"] = j.timeoutSec }
          when (j.continueOnError) { ["continueOnError"] = true }
          when (j.`if` != null) { ["if"] = j.`if` }
          when (j.allow != null) { ["allow"] = j.allow }
          when (j.services != null) {
            ["services"] = new Listing {
              for (sv in j.services!!) {
                new Dynamic {
                  ["name"] = sv.name
                  ["image"] = sv.image
                  when (sv.env != null) { ["env"] = sv.env }
                  when (sv.ports != null) { ["ports"] = sv.ports }
                  when (sv.health != null) { ["health"] = sv.health }
                  when (sv.timeout > 0) { ["timeout"] = sv.timeout }
                }
              }
            }
          }
          when (j.matrix != null) { ["matrix"] = j.matrix }
        }
      }
    }
  }
}
