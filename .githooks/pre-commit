#!/usr/bin/env bash
# Ship Happens pre-commit hook — FAST checks only (keep this < ~2s so nobody
# reaches for --no-verify). The heavy dogfooded gate (race tests, coverage)
# runs in pre-push and CI.
#
# Enable once with:  make hooks   (sets core.hooksPath to .githooks)
set -euo pipefail

# Only look at staged Go files.
staged_go=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' || true)

if [ -n "$staged_go" ]; then
  # gofmt: reject unformatted files (list offenders, don't auto-fix).
  unformatted=$(gofmt -l $staged_go || true)
  if [ -n "$unformatted" ]; then
    echo "✗ gofmt: these staged files are not formatted:" >&2
    echo "$unformatted" | sed 's/^/    /' >&2
    echo "  run: gofmt -w $unformatted" >&2
    exit 1
  fi
fi

# Compile + vet the whole module (fast; uses the build cache).
echo "• go build ./..."
go build ./...
echo "• go vet ./..."
go vet ./...

echo "✓ pre-commit checks passed"
