/// Matrix + robustness demo — the Pkl port of demos/matrix-app.
///
///     ship run demos/matrix-app/pipeline.pkl --tui
///     ship run demos/matrix-app/pipeline.pkl --no-tui   # see per-step tool output
///
/// `test` fans out over os × go into four parallel jobs (`test/<go>-<os>`, keys
/// sorted) with $OS/$GO set — the same expansion the Go DSL's Matrix(...) does,
/// now a first-class Pkl field. Dependents that `needs { "test" }` are rewired
/// to all four expansions automatically. `flaky` shows retries; `optional`
/// shows a per-step timeout + continue-on-error.
amends "../../pkl/ship.pkl"

name = "Matrix + Robustness"

jobs {
  // Fan-out: 2 OSes × 2 Go versions = 4 parallel jobs.
  ["test"] {
    matrix {
      ["os"] { "linux"; "mac" }
      ["go"] { "1.21"; "1.22" }
    }
    steps { new { id = "info"; run = "echo \"testing on $OS with Go $GO\" && sleep 0.5" } }
  }

  // Retries: fails on the first attempt, succeeds on the second.
  ["flaky"] {
    needs { "test" }
    cleanAfter { ".flaky-done" }
    steps {
      new {
        id = "attempt"
        run = "if [ -f .flaky-done ]; then echo ok; else touch .flaky-done; echo 'fail #1'; exit 1; fi"
        retries = 2
      }
    }
  }

  // Timeout + continue-on-error: a slow step that times out but doesn't fail the run.
  ["optional"] {
    needs { "test" }
    continueOnError = true
    steps { new { id = "slow"; run = "sleep 10"; timeoutSec = 1 } }
  }

  ["done"] {
    needs { "test"; "flaky"; "optional" }
    steps { new { id = "summary"; run = "echo 'matrix complete; optional may have failed harmlessly'" } }
  }
}
